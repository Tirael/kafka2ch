{
  "extends": "clickhouse.codegen.json",
  "defaults": {
    "persistKafkaMeta": {
      "partition": true,
      "offset": true
    }
  },
  "pipeline": {
    "mergeTreeTables": [
      {
        "tableName": "orders",
        "engine": "ReplacingMergeTree",
        "orderBy": "(event_time, order_id, kafka_partition, kafka_offset)",
        "includeKafkaMeta": true,
        "columns": [
          { "name": "order_id", "type": "String" },
          { "name": "category", "type": "LowCardinality(String)" },
          { "name": "currency", "type": "LowCardinality(String)" },
          { "name": "amount", "type": "Float64" },
          { "name": "quantity", "type": "UInt32" },
          { "name": "status", "type": "LowCardinality(String)" },
          { "name": "payment", "type": "LowCardinality(String)" },
          { "name": "event_time", "type": "DateTime64(3)" }
        ]
      }
    ],
    "trailingSql": null,
    "aggregates": [
      {
        "name": "orders_agg_1m",
        "viewName": "orders_agg_mv",
        "sourceTable": "orders",
        "timeBucket": { "column": "event_time", "function": "toStartOfMinute", "alias": "minute" },
        "groupBy": [ "category" ],
        "measures": [
          { "function": "count", "alias": "orders_count" },
          { "function": "sum", "column": "amount", "alias": "total_amount" },
          { "function": "sum", "column": "quantity", "alias": "total_qty" }
        ],
        "refresh": { "every": "1 MINUTE" }
      }
    ]
  }
}
