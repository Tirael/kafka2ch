<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local pack output for smoke tests: dotnet pack -o artifacts/nuget -->
    <add key="local-artifacts" value="./artifacts/nuget" />
  </packageSources>
</configuration>
