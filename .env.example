KAFKA_IMAGE=confluentinc/cp-kafka:7.8.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:7.8.0
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.6.3.62
CLICKHOUSE_PASSWORD=sandbox
KAFKA_BROKER_LIST=kafka:9092
# Staging/prod SASL (kafka.sasl.xml.example) — set from a secret store, never commit values:
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
