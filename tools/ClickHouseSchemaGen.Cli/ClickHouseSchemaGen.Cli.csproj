<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClickHouseSchemaGen.Cli</RootNamespace>
    <SkipClickHouseCodegen>true</SkipClickHouseCodegen>

    <UseAppHost>false</UseAppHost>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clickhouse-schema-gen</ToolCommandName>
    <PackageId>ClickHouseSchemaGen.Cli</PackageId>
    <Description>dotnet tool: generate ClickHouse DDL and schema migrations from clickhouse.codegen.json.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <ProjectReference Include="..\ClickHouseSchemaGen\ClickHouseSchemaGen.csproj" />
  </ItemGroup>

</Project>
