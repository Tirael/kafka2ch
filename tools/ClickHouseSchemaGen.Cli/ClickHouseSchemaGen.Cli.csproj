<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClickHouseSchemaGen.Cli</RootNamespace>
    <SkipClickHouseCodegen>true</SkipClickHouseCodegen>
    <!-- Apphost .exe under bin/ is frequently blocked by AppLocker in closed contours; prefer `dotnet exec`. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <ProjectReference Include="..\ClickHouseSchemaGen\ClickHouseSchemaGen.csproj" />
    <ProjectReference Include="..\..\src\Sandbox.Contracts\Sandbox.Contracts.csproj" />
  </ItemGroup>

</Project>
