<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClickHouseSchemaGen.Migrator</RootNamespace>
    <SkipClickHouseCodegen>true</SkipClickHouseCodegen>
    <UseAppHost>false</UseAppHost>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clickhouse-schema-migrator</ToolCommandName>
    <PackageId>ClickHouseSchemaGen.Migrator</PackageId>
    <Description>dotnet tool: apply ClickHouseSchemaGen SQL migrations to a ClickHouse server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <ProjectReference Include="..\ClickHouseSchemaGen\ClickHouseSchemaGen.csproj" />
  </ItemGroup>

</Project>
