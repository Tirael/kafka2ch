<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ClickHouseSchemaGen.Tasks</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseAppHost>false</UseAppHost>
    <SkipClickHouseCodegen>true</SkipClickHouseCodegen>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <IsPackable>true</IsPackable>
    <PackageId>ClickHouseSchemaGen.Tasks</PackageId>
    <Description>MSBuild tasks that generate ClickHouse Kafka/MergeTree DDL from protobuf message assemblies and clickhouse.codegen.json.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_ClickHouseSchemaGen_PackTaskAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClickHouseSchemaGen\ClickHouseSchemaGen.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\ClickHouseSchemaGen.Tasks.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Import Project="build\ClickHouseSchemaGen.Tasks.targets" Condition="'$(ClickHouseSchemaGenTasksTargetsImported)' != 'true'" />

  <!-- In-repo MSBuild of this project: generator DLLs live in $(TargetDir), not the package tools/ folder. -->
  <Target Name="_SetClickHouseSchemaGenTasksAssemblyDir" BeforeTargets="GenerateClickHouseDdl">
    <PropertyGroup>
      <ClickHouseSchemaGenTasksAssemblyDir>$(TargetDir)</ClickHouseSchemaGenTasksAssemblyDir>
    </PropertyGroup>
  </Target>

  <Target Name="_ClickHouseSchemaGen_PackTaskAssemblies" DependsOnTargets="Build">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)*.dll" PackagePath="tools\net8.0\" />
      <TfmSpecificPackageFile Include="$(TargetDir)*.json" PackagePath="tools\net8.0\" Condition="Exists('%(Identity)')" />
    </ItemGroup>
  </Target>

</Project>
