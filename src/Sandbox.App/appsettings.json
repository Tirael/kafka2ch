{
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SchemaRegistryUrl": "http://schema-registry:8081"
  },
  "PublishOrders": {
    "Topic": "orders",
    "IntervalMs": 500
  },
  "PublishShipments": {
    "Topic": "shipments",
    "IntervalMs": 750
  },
  "ClickHouse": {
    "Host": "clickhouse",
    "Port": 8123,
    "Database": "default",
    "Username": "default",
    "Password": "sandbox"
  },
  "ReadAggregates": {
    "IntervalMs": 5000,
    "WindowMinutes": 10
  },
  "VerifyStoredMessages": {
    "OrdersTopic": "orders",
    "ShipmentsTopic": "shipments",
    "GroupId": "sandbox-stored-messages",
    "OrdersTable": "orders_full",
    "ShipmentsTable": "shipments_full",
    "OrdersProjectionTable": "orders",
    "ShipmentsProjectionTable": "shipments",
    "PollIntervalMs": 1000,
    "WaitTimeoutMs": 90000
  }
}
