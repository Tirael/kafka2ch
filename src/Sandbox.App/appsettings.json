{
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "SchemaRegistryUrl": "http://schema-registry:8081"
  },
  "PublishOrders": {
    "Topic": "orders",
    "IntervalMs": 500
  },
  "ClickHouse": {
    "Host": "clickhouse",
    "Port": 8123,
    "Database": "default",
    "Username": "default",
    "Password": "sandbox"
  },
  "ReadAggregates": {
    "IntervalMs": 5000,
    "WindowMinutes": 10
  },
  "ConsumerHealth": {
    "IntervalMs": 30000,
    "QueueTable": "orders_queue",
    "ErrorsTable": "orders_queue_errors",
    "MaxPollAgeSeconds": 60,
    "MaxCommitAgeMinutes": 5,
    "ErrorWindowMinutes": 5
  }
}
