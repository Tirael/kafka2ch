<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Sandbox.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProtoSchema Include="protos/**/*.proto" />
    <Protobuf Include="@(ProtoSchema)" ProtoRoot="protos" />
  </ItemGroup>

  <Target Name="SyncProtoSchemas" AfterTargets="Build">
    <Copy SourceFiles="@(ProtoSchema)" DestinationFiles="@(ProtoSchema->'$(MSBuildProjectDirectory)/../../docker/clickhouse/format_schemas/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    In-repo: MSBuild local Tasks (no NuGet pack required). Escape: SkipClickHouseCodegen=true.
    External: PackageReference ClickHouseSchemaGen.Tasks — see README.
  -->
  <Target Name="GenerateClickHouseDdl" AfterTargets="SyncProtoSchemas" Condition="'$(SkipClickHouseCodegen)' != 'true'">
    <PropertyGroup>
      <_ClickHouseSchemaGenTasksProject>$(MSBuildProjectDirectory)/../../tools/ClickHouseSchemaGen.Tasks/ClickHouseSchemaGen.Tasks.csproj</_ClickHouseSchemaGenTasksProject>
      <_ClickHouseCodegenConfig>$(MSBuildProjectDirectory)/clickhouse.codegen.json</_ClickHouseCodegenConfig>
      <_ClickHouseClusterCodegenConfig>$(MSBuildProjectDirectory)/clickhouse.codegen.cluster.json</_ClickHouseClusterCodegenConfig>
      <_ClickHouseClusterReplicatedDbCodegenConfig>$(MSBuildProjectDirectory)/clickhouse.codegen.cluster.replicated-db.json</_ClickHouseClusterReplicatedDbCodegenConfig>
    </PropertyGroup>
    <MSBuild Projects="$(_ClickHouseSchemaGenTasksProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);SkipClickHouseCodegen=true" />
    <MSBuild Projects="$(_ClickHouseSchemaGenTasksProject)" Targets="GenerateClickHouseDdl" Properties="Configuration=$(Configuration);SkipClickHouseCodegen=true;ClickHouseCodegenConfig=$(_ClickHouseCodegenConfig);ClickHouseCodegenAssemblies=$(TargetPath)" />
    <MSBuild Projects="$(_ClickHouseSchemaGenTasksProject)" Targets="GenerateClickHouseDdl" Properties="Configuration=$(Configuration);SkipClickHouseCodegen=true;ClickHouseCodegenConfig=$(_ClickHouseClusterCodegenConfig);ClickHouseCodegenAssemblies=$(TargetPath)" Condition="Exists('$(_ClickHouseClusterCodegenConfig)')" />
    <MSBuild Projects="$(_ClickHouseSchemaGenTasksProject)" Targets="GenerateClickHouseDdl" Properties="Configuration=$(Configuration);SkipClickHouseCodegen=true;ClickHouseCodegenConfig=$(_ClickHouseClusterReplicatedDbCodegenConfig);ClickHouseCodegenAssemblies=$(TargetPath)" Condition="Exists('$(_ClickHouseClusterReplicatedDbCodegenConfig)')" />
  </Target>

</Project>
