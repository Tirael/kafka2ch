<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sandbox.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProtoSchema Include="protos/**/*.proto" />
    <Protobuf Include="@(ProtoSchema)" ProtoRoot="protos" />
  </ItemGroup>

  <Target Name="SyncProtoSchemas" AfterTargets="Build">
    <Copy SourceFiles="@(ProtoSchema)" DestinationFiles="@(ProtoSchema->'$(MSBuildProjectDirectory)/../../docker/clickhouse/format_schemas/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Codegen runs in-process (RoslynCodeTaskFactory + shadow-copied assemblies), not via
    <Exec>dotnet …Cli.dll</Exec> (AppLocker) and not via UsingTask on bin/*.dll (MSB3027 lock).

    Escape hatch: dotnet build -p:SkipClickHouseCodegen=true
  -->
  <Target Name="GenerateClickHouseDdl" AfterTargets="SyncProtoSchemas" Condition="'$(SkipClickHouseCodegen)' != 'true'">
    <PropertyGroup>
      <_ClickHouseSchemaGenTasksProject>$(MSBuildProjectDirectory)/../../tools/ClickHouseSchemaGen.Tasks/ClickHouseSchemaGen.Tasks.csproj</_ClickHouseSchemaGenTasksProject>
      <_ClickHouseCodegenConfig>$(MSBuildProjectDirectory)/clickhouse.codegen.json</_ClickHouseCodegenConfig>
    </PropertyGroup>
    <MSBuild Projects="$(_ClickHouseSchemaGenTasksProject)" Targets="Restore;Build" Properties="Configuration=$(Configuration);SkipClickHouseCodegen=true" />
    <MSBuild Projects="$(_ClickHouseSchemaGenTasksProject)" Targets="GenerateClickHouseDdl" Properties="Configuration=$(Configuration);SkipClickHouseCodegen=true;ClickHouseCodegenConfig=$(_ClickHouseCodegenConfig)" />
  </Target>

</Project>
